  <Target Name="MergeFlareResources" AfterTargets="Build">
    <PropertyGroup>
      <_FlareToolArchitecture Condition="'$(PROCESSOR_ARCHITECTURE)'=='ARM64'">arm64</_FlareToolArchitecture>
      <_FlareToolArchitecture Condition="'$(_FlareToolArchitecture)'==''">x64</_FlareToolArchitecture>
      <_FlareMakePri>$(WindowsSdkDir)bin\$(WindowsTargetPlatformVersion)\$(_FlareToolArchitecture)\makepri.exe</_FlareMakePri>
    </PropertyGroup>
    <ItemGroup><_FlareComponentPri Include="$(OutDir)*.pri" Exclude="$(OutDir)resources.pri" /></ItemGroup>
    <MakeDir Directories="$(IntDir)pri-input" />
    <Copy SourceFiles="@(_FlareComponentPri)" DestinationFolder="$(IntDir)pri-input" SkipUnchangedFiles="true" />
    <Exec Command="&quot;$(_FlareMakePri)&quot; new /pr &quot;$(IntDir)pri-input&quot; /cf &quot;$(MSBuildThisFileDirectory)priconfig.xml&quot; /of &quot;$(OutDir)resources.pri&quot; /o" StdOutEncoding="utf-16" StdErrEncoding="utf-16" />
